# ============================================
# Dockerfile.web - politicape-web (Railway)
# Scrapping backend + React frontend
# Build context: raiz del monorepo (PoliticaPE/)
# ============================================

# --- Stage 1: Build React frontend ---
FROM node:20-slim AS frontend
WORKDIR /build
COPY project-react/package*.json ./
RUN npm ci --production=false
COPY project-react/ ./
RUN npm run build

# --- Stage 2: Python backend ---
FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    SERVE_FRONTEND=true

RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc g++ libpq-dev curl \
    && rm -rf /var/lib/apt/lists/*

RUN useradd --create-home --shell /bin/bash app
WORKDIR /app

COPY project-scrapping/requirements.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

COPY project-scrapping/ ./

# Colocar dist donde main.py lo busca (3 niveles arriba de app/main.py → /project-react/dist)
COPY --from=frontend /build/dist /project-react/dist

RUN chown -R app:app /app /project-react
USER app

HEALTHCHECK --interval=30s --timeout=10s --start-period=10s --retries=3 \
    CMD curl -f http://localhost:${PORT:-8000}/health || exit 1

CMD ["sh", "-c", "uvicorn app.main:app --host 0.0.0.0 --port ${PORT:-8000}"]
