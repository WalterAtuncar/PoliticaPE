# === PoliticaPE - Variables de Entorno ===
# Copiar este archivo a .env y completar los valores

# Database (Neon PostgreSQL)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Sniffing service (para proxy desde scrapping)
SNIFFING_URL=http://localhost:8080
SNIFFING_WS_URL=ws://localhost:8080

# Frontend serving (true solo en produccion/Railway)
SERVE_FRONTEND=false

# API Keys (opcionales)
TWITTER_BEARER_TOKEN=
YOUTUBE_API_KEY=
FACEBOOK_ACCESS_TOKEN=
INSTAGRAM_ACCESS_TOKEN=
ANTHROPIC_API_KEY=
