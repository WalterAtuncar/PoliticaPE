modules = ["nodejs-20", "python-3.11", "postgresql-16"]
[agent]
expertMode = true

[nix]
channel = "stable-25_05"
packages = ["cargo", "libiconv", "rustc"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Frontend"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Backend-Scrapping"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Backend-Sniffing"

[[workflows.workflow]]
name = "Frontend"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd project-react && npm run dev"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow]]
name = "Backend-Scrapping"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd project-scrapping && python -m uvicorn app.main:app --host 0.0.0.0 --port 8000 --reload"
waitForPort = 8000

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow]]
name = "Backend-Sniffing"
author = "agent"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd project-sniffing/microservice && python -m uvicorn main:app --host 0.0.0.0 --port 8080 --reload"
waitForPort = 8080

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 5001
externalPort = 3000

[[ports]]
localPort = 8000
externalPort = 8000

[[ports]]
localPort = 8080
externalPort = 8080

[deployment]
deploymentTarget = "vm"
run = ["bash", "-c", "cd project-scrapping && SERVE_FRONTEND=true python -m uvicorn app.main:app --host 0.0.0.0 --port 8000"]
build = ["bash", "-c", "cd project-react && npm run build"]
publicDir = "\"\""

[userenv]

[userenv.production]
SERVE_FRONTEND = "true"
