# Application Configuration
APP_NAME=Political Data Scraper
VERSION=1.0.0
DEBUG=false
ENVIRONMENT=production

# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/political_data

# Redis
REDIS_URL=redis://localhost:6379/0

# API Keys (Required for social media scraping)
TWITTER_BEARER_TOKEN=your_twitter_bearer_token_here
FACEBOOK_ACCESS_TOKEN=your_facebook_access_token_here
INSTAGRAM_ACCESS_TOKEN=your_instagram_access_token_here
YOUTUBE_API_KEY=your_youtube_api_key_here

# Scraping Configuration
SCRAPING_DELAY=1.0
CONCURRENT_REQUESTS=8
USER_AGENT=PoliticalDataBot/1.0
REQUEST_TIMEOUT=30

# Rate Limiting
RATE_LIMIT_CALLS=100
RATE_LIMIT_PERIOD=60

# Celery Configuration
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Scheduling (in seconds)
NEWS_SCRAPING_INTERVAL=900
SOCIAL_SCRAPING_INTERVAL=300
GOVERNMENT_SCRAPING_INTERVAL=3600

# Sentiment Analysis
SENTIMENT_MODEL=bert-base-multilingual-uncased-sentiment
BATCH_SIZE=32

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/scraper.log

# Monitoring
METRICS_PORT=8001
PROMETHEUS_ENABLED=true